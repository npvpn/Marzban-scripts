# Скопируйте в migration.env и выполните chmod 600. Не коммитьте секреты.
#
# Топология (выберите один вариант — подробности в README.md):
#   A) Панель на платформе: PANEL_* = TARGET_* (fork на платформе). Шаг 08 пропустить.
#   B) Partner-панель: PANEL_* на source /opt/marzban после шага 08. Задать TARGET_BOT_DOMAIN.

SOURCE_HOST=138.124.67.110
SOURCE_USER=root
SOURCE_PATH=/home/vpnZabBot
TARGET_HOST=213.165.57.217
TARGET_USER=root
TARGET_PATH=/home/pontvpn_bot

PG_CONTAINER=pg_nvb
MYSQL_CONTAINER=nvb_mysql

# Куда смотрят шаги 04–07 и 09 (MySQL/API панели).
# До шага 08 (сценарий B): по умолчанию в common.sh = SOURCE_* / MYSQL_CONTAINER.
# Сценарий A: явно задать TARGET_* перед шагом 09.
# Сценарий B: после шага 08 — PANEL_PATH=/opt/marzban, PANEL_MYSQL_CONTAINER=marzban-mysql-1
PANEL_HOST=
PANEL_USER=
PANEL_PATH=
PANEL_MYSQL_CONTAINER=
PANEL_ENV_FILE=

SOURCE_BOT_USERNAME=vpnZabBot
TARGET_BOT_USERNAME=vpnZab_copy_bot
TARGET_BOT_ID=3
TARGET_SERVER_ID=1
TARGET_BOT_API_TOKEN=
TARGET_BOT_PUBLIC_NAME=vpnZab_copy_bot
# Сценарий B: домен partner-панели (Grafana, external MySQL). Сценарий A: оставить пустым.
TARGET_BOT_DOMAIN=
TARGET_BOT_ADMIN_ID=1

# Не храните реальные пароли в файле. Экспортируйте в shell перед запуском скриптов.
SOURCE_MARZBAN_ADMIN_USERNAME=admin
SOURCE_MARZBAN_ADMIN_PASSWORD=
TARGET_MARZBAN_ADMIN_USERNAME=admin
TARGET_MARZBAN_ADMIN_PASSWORD=
PANEL_SSH_PASSWORD=
MIGRATION_SSH_PASSWORD=

# Только шаг 08 (сценарий B — install-partner на source). В сценарии A пропустить.
PARTNER_PANEL_DOMAIN=
PARTNER_CERT_EMAIL=
PARTNER_MYSQL_PASSWORD=
PARTNER_ADMIN_USERNAME=
PARTNER_ADMIN_PASSWORD_HASH=
PARTNER_SUBSCRIPTION_TITLE=
PARTNER_SUPPORT_TELEGRAM=
PARTNER_BOT_TELEGRAM=
# Публичный IPv4 TARGET_HOST — UFW откроет MySQL 3306 только для Grafana на платформе
PARTNER_BOT_SERVER_IP=
PARTNER_PANEL_UVICORN_PORT=8001
PARTNER_DATABASE_TYPE=mysql

# Шаг 09: дамп legacy MySQL → импорт в fork panel MySQL (см. README, MYSQL_SWAP_AT_RESTORE)
MYSQL_SWAP_AT_RESTORE=true
LEGACY_MARZBAN_CONTAINER=nvb_marz
PARTNER_MARZBAN_VERSION=latest
PARTNER_SKIP_DNS_CHECK=false
PARTNER_SKIP_CERT=false
PARTNER_SKIP_FIREWALL=false
PARTNER_NO_LOGS=true
PARTNER_INSTALL_SCRIPT_LOCAL_PATH=

ARTIFACT_ROOT=./artifacts
